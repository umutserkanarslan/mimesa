---
import { Image } from 'astro:assets';
import { type Locale, getDict } from '@/lib/i18n';
import FadeIn from './FadeIn.astro';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = getDict(lang).chef;

const portrait = 'https://images.unsplash.com/photo-1581349485608-9469926a8e5e?auto=format&fit=crop&w=1400&q=80';
---

<section id="chef" class="relative bg-[var(--color-offwhite)] text-[var(--color-ink)] py-28 md:py-44 overflow-hidden grain-bg">
  <div class="container-luxe relative z-10">
    <div class="grid grid-cols-12 gap-x-6 gap-y-14 items-center">

      <FadeIn class="col-span-12 md:col-span-7 lg:col-span-7">
        <div class="relative">
          <div class="absolute -top-6 -start-6 w-24 h-24 border-t border-s border-[var(--color-copper)]/60"></div>
          <Image
            src={portrait}
            alt={t.name}
            width={1400}
            height={1750}
            loading="lazy"
            class="w-full h-auto object-cover"
            style="aspect-ratio:4/5;"
          />
          <div class="absolute -bottom-6 -end-6 w-24 h-24 border-b border-e border-[var(--color-copper)]/60"></div>
        </div>
      </FadeIn>

      <div class="col-span-12 md:col-span-5 lg:col-start-9 lg:col-span-4 flex flex-col gap-7">
        <FadeIn delay={120} class="flex items-center gap-4">
          <span class="hairline w-12"></span>
          <span class="eyebrow">{t.eyebrow}</span>
        </FadeIn>

        <FadeIn delay={240}>
          <h2 style="font-family:var(--font-display);font-size:clamp(2.2rem,5vw,4.2rem);line-height:1.05;font-weight:400;">
            {t.title && <span class="block">{t.title}</span>}
            <span class="block">
              {t.titleLead && <span style="color:var(--color-ink);">{t.titleLead} </span>}
              <span class="italic" style="color:var(--color-copper);">{t.titleEm}</span>
            </span>
          </h2>
        </FadeIn>

        <FadeIn delay={360}>
          <p class="text-[1.02rem] md:text-[1.08rem] leading-[1.85] italic text-[var(--color-ink)]/85" style="font-family:var(--font-display);">{t.quote}</p>
        </FadeIn>

        <FadeIn delay={480} class="flex flex-col gap-5">
          <p class="text-[0.98rem] leading-[1.85] text-[var(--color-ink)]/75">{t.body}</p>
          {t.body2 && <p class="text-[0.98rem] leading-[1.85] text-[var(--color-ink)]/75">{t.body2}</p>}
          {t.body3 && <p class="text-[0.98rem] leading-[1.85] text-[var(--color-ink)]/75">{t.body3}</p>}
        </FadeIn>

        <FadeIn delay={600} class="mt-3 flex items-center gap-4">
          <span class="hairline w-10"></span>
          <span class="text-[0.78rem] uppercase text-[var(--color-ink)]/60" style="letter-spacing:var(--tracking-wider-luxe);">{t.name}</span>
        </FadeIn>
      </div>
    </div>
  </div>
</section>
