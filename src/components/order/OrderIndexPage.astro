---
// Clone of MenuIndexPage. Same crest, same typography. CTA leads to the
// order categories grid instead of the menu's.
import BaseLayout from '@/layouts/BaseLayout.astro';
import MenuTopBar from '@/components/menu/MenuTopBar.astro';
import { type Locale, getDict, localizedPath } from '@/lib/i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const dict = getDict(lang);
const m = dict.orderPage.meta;
const s = dict.orderPage.splash;

const homeHref = localizedPath(lang, '/');
const categoriesHref = localizedPath(lang, '/siparis-ver/kategoriler');
const contact = dict.contact;
---

<BaseLayout lang={lang} title={m.title} description={m.description} ogAlt={m.ogAlt}>
  <MenuTopBar lang={lang} backHref={homeHref} backLabel={s.backHome} />

  <main class="relative bg-[var(--color-champagne)] grain-bg min-h-[calc(100svh-58px)] md:min-h-[calc(100svh-68px)] flex flex-col">
    <div class="absolute top-[10%] start-6 md:start-12 w-px h-[18%] bg-[var(--color-copper)]/30 pointer-events-none"></div>
    <div class="absolute bottom-[14%] end-6 md:end-12 w-px h-[14%] bg-[var(--color-copper)]/30 pointer-events-none"></div>

    <span
      aria-hidden="true"
      class="pointer-events-none absolute -top-12 end-0 md:-top-20 md:end-12 select-none opacity-[0.04]"
      style="font-family:var(--font-display);font-style:italic;font-size:clamp(18rem, 38vw, 38rem);line-height:0.8;color:var(--color-copper);"
    >M</span>

    <div class="flex-1 flex items-center justify-center px-6 py-16 md:py-24 relative z-10">
      <div class="text-center max-w-md">
        <div class="reveal flex justify-center" style="--reveal-delay:60ms;">
          <div class="relative inline-flex items-center justify-center" style="width:clamp(180px, 28vw, 240px); aspect-ratio: 1/1;">
            <span class="absolute inset-0 rounded-full border border-[var(--color-copper)]/45" aria-hidden="true"></span>
            <span class="absolute inset-3 rounded-full border border-[var(--color-copper)]/25" aria-hidden="true"></span>
            <span class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 w-2.5 h-2.5 rotate-45 border-t border-r border-[var(--color-copper)]/60 bg-[var(--color-champagne)]" aria-hidden="true"></span>
            <span class="absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-1/2 w-2.5 h-2.5 rotate-45 border-b border-l border-[var(--color-copper)]/60 bg-[var(--color-champagne)]" aria-hidden="true"></span>
            <span class="block italic" style="font-family:var(--font-display);font-weight:500;font-size:clamp(3.5rem, 8vw, 5.5rem);color:var(--color-ink);line-height:1;">
              Mi&nbsp;Mesa
            </span>
          </div>
        </div>

        <p class="reveal eyebrow mt-10" style="--reveal-delay:200ms;">{s.welcome}</p>

        <p
          class="reveal mt-5 italic text-[var(--color-ink)]/70"
          style="--reveal-delay:340ms;font-family:var(--font-display);font-size:clamp(1.05rem, 1.6vw, 1.2rem);line-height:1.5;"
        >
          {s.tagline}
        </p>

        <span class="reveal block hairline mx-auto w-12 mt-8" style="--reveal-delay:480ms;"></span>

        <div class="reveal mt-10" style="--reveal-delay:620ms;">
          <a href={categoriesHref} class="btn-copper">
            {s.enterButton}
            <svg
              aria-hidden="true"
              class:list={["w-3 h-3", lang === 'ar' && "scale-x-[-1]"]}
              viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"
            >
              <path d="M5.5 3L10.5 8L5.5 13" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    <footer class="relative z-10 pb-8 md:pb-10 px-6">
      <div class="container-luxe flex items-center justify-center gap-3">
        <span class="block w-6 h-px bg-[var(--color-copper)]/40"></span>
        <span class="text-[0.7rem] text-[var(--color-ink)]/55" style="letter-spacing:var(--tracking-wider-luxe);text-transform:uppercase;">
          {contact.address}
        </span>
        <span class="block w-6 h-px bg-[var(--color-copper)]/40"></span>
      </div>
    </footer>
  </main>
</BaseLayout>
