---
// Clone of MenuCategoriesPage. Same 2-column tile grid, but tiles link to
// /siparis-ver/[slug] via OrderCategoryCard.
import BaseLayout from '@/layouts/BaseLayout.astro';
import MenuTopBar from '@/components/menu/MenuTopBar.astro';
import FadeIn from '@/components/FadeIn.astro';
import OrderCategoryCard from '@/components/order/OrderCategoryCard.astro';
import { type Locale, getDict, localizedPath } from '@/lib/i18n';
import { getCategories, getAllItems } from '@/lib/menu';

interface Props { lang: Locale }
const { lang } = Astro.props;
const dict = getDict(lang);
const m = dict.orderPage.meta;
const idx = dict.orderPage.index;
const c = dict.orderPage.category;

const categories = await getCategories();
const allItems = await getAllItems();
const splashHref = localizedPath(lang, '/siparis-ver');

Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=30, stale-while-revalidate=300'
);
---

<BaseLayout lang={lang} title={m.title} description={m.description} ogAlt={m.ogAlt}>
  <MenuTopBar lang={lang} backHref={splashHref} backLabel={c.backToSplash} />

  <main class="bg-[var(--color-champagne)] grain-bg">
    <section class="relative pt-10 pb-6 md:pt-14 md:pb-10">
      <div class="container-luxe text-center">
        <span class="eyebrow">{idx.eyebrow}</span>
        <h1
          class="mt-3"
          style="font-family:var(--font-display);font-size:clamp(1.75rem, 3.4vw, 2.6rem);line-height:1.05;letter-spacing:-0.01em;font-weight:400;color:var(--color-ink);"
        >
          <span class="italic" style="color:var(--color-copper);">{idx.titleEm}</span>
        </h1>
        <p class="mt-5 text-[0.95rem] leading-[1.7] text-[var(--color-ink)]/70 max-w-xl mx-auto">
          {idx.subtitle}
        </p>
        <span class="block hairline mx-auto w-12 mt-6"></span>
      </div>
    </section>

    <section class="relative pb-24 md:pb-32">
      <div class="container-luxe">
        <div class="grid grid-cols-2 gap-3 sm:gap-4 md:gap-6 max-w-5xl mx-auto">
          {categories.map((cat, i) => (
            <FadeIn delay={Math.min(i, 3) * 60}>
              <OrderCategoryCard
                lang={lang}
                category={cat}
                index={i + 1}
                total={categories.length}
                itemCount={allItems.filter((it) => it.category === cat.slug).length}
                itemsLabel={idx.itemsLabel}
              />
            </FadeIn>
          ))}
        </div>

        <FadeIn delay={120}>
          <div class="mt-16 md:mt-20 max-w-xl mx-auto text-center px-4">
            <span class="block hairline mx-auto w-12 mb-5"></span>
            <p
              class="text-[0.78rem] md:text-[0.82rem] leading-[1.8] text-[var(--color-ink)]/85 italic"
              style="font-family:var(--font-display);"
            >
              {idx.footnote}
            </p>
          </div>
        </FadeIn>
      </div>
    </section>
  </main>
</BaseLayout>
