---
// Checkout page — basket summary (left) + form (right). The basket summary is
// rendered client-side from localStorage so it always reflects the current cart.
import BaseLayout from '@/layouts/BaseLayout.astro';
import MenuTopBar from '@/components/menu/MenuTopBar.astro';
import FadeIn from '@/components/FadeIn.astro';
import OrderForm from '@/components/order/OrderForm.astro';
import { type Locale, getDict, localizedPath } from '@/lib/i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const dict = getDict(lang);
const m = dict.orderPage.meta;
const t = dict.orderPage.checkout;
const cart = dict.orderPage.cart;
const browseHref = localizedPath(lang, '/siparis-ver/kategoriler');
---

<BaseLayout lang={lang} title={t.title} description={m.description} ogAlt={m.ogAlt}>
  <MenuTopBar lang={lang} backHref={browseHref} backLabel={t.backToOrder} title={t.title} />

  <main class="bg-[var(--color-champagne)] grain-bg pb-24">
    <section class="relative pt-12 md:pt-16 pb-6 md:pb-10">
      <div class="container-luxe text-center max-w-2xl mx-auto">
        <span class="eyebrow">{dict.orderPage.index.eyebrow}</span>
        <h1
          class="mt-4"
          style="font-family:var(--font-display);font-size:clamp(1.8rem, 4.4vw, 3rem);line-height:1.1;font-weight:400;color:var(--color-ink);"
        >
          {t.title}
        </h1>
        <p class="mt-4 text-[0.95rem] leading-[1.7] text-[var(--color-ink)]/70 max-w-md mx-auto">
          {t.subtitle}
        </p>
        <span class="block hairline mx-auto w-12 mt-6"></span>
      </div>
    </section>

    <section class="container-luxe">
      <div class="relative max-w-5xl mx-auto">
        <!-- Corner clamps — sit OUTSIDE the card edges so they read like
             brass corners holding a vellum invitation, not as decoration
             nested inside another border. Bold copper, no opacity. -->
        <span class="absolute -top-1 -start-1 sm:-top-1.5 sm:-start-1.5 w-9 h-9 md:w-11 md:h-11 border-t-2 border-s-2 border-[var(--color-copper)] pointer-events-none z-10" aria-hidden="true"></span>
        <span class="absolute -top-1 -end-1 sm:-top-1.5 sm:-end-1.5 w-9 h-9 md:w-11 md:h-11 border-t-2 border-e-2 border-[var(--color-copper)] pointer-events-none z-10" aria-hidden="true"></span>
        <span class="absolute -bottom-1 -start-1 sm:-bottom-1.5 sm:-start-1.5 w-9 h-9 md:w-11 md:h-11 border-b-2 border-s-2 border-[var(--color-copper)] pointer-events-none z-10" aria-hidden="true"></span>
        <span class="absolute -bottom-1 -end-1 sm:-bottom-1.5 sm:-end-1.5 w-9 h-9 md:w-11 md:h-11 border-b-2 border-e-2 border-[var(--color-copper)] pointer-events-none z-10" aria-hidden="true"></span>

        <!-- Card itself: no border, lifted by a warm shadow so it sits
             above the champagne page surface. -->
        <div class="relative bg-[var(--color-offwhite)] shadow-[0_30px_70px_-25px_rgba(26,26,26,0.28)] px-7 sm:px-12 md:px-20 py-12 md:py-20">
          <!-- Matted inner hairline — a second line just inside the card,
               echoing how a framed print has a matt board with an inner
               keyline around the artwork. Subtle but adds real depth. -->
          <div class="absolute inset-4 md:inset-5 border border-[var(--color-copper)]/20 pointer-events-none"></div>

          <div class="relative grid grid-cols-12 gap-x-8 md:gap-x-16 gap-y-12">

            <FadeIn class="col-span-12 md:col-span-5 md:border-e md:border-[var(--color-copper)]/25 md:pe-12">
              <span class="eyebrow">{t.summaryTitle}</span>
              <span class="block hairline w-10 mt-3 mb-8"></span>

              <div data-summary-empty hidden class="text-[0.95rem] text-[var(--color-ink)]/65 italic">
                <p>{t.summaryEmpty}</p>
                <a href={browseHref} class="mt-4 inline-flex items-center gap-2 text-[0.78rem] uppercase text-[var(--color-copper)] hover:text-[var(--color-charcoal)]" style="letter-spacing:var(--tracking-wider-luxe);">
                  {cart.browseMenu}
                </a>
              </div>

              <ul data-summary-lines class="divide-y divide-[var(--color-copper)]/15"></ul>

              <div data-summary-total hidden class="mt-6 pt-5 border-t border-[var(--color-copper)]/30 flex items-baseline justify-between">
                <span class="text-[0.78rem] uppercase text-[var(--color-ink)]/60" style="letter-spacing:var(--tracking-wide-luxe);">{cart.total}</span>
                <span data-summary-total-value class="italic" style="font-family:var(--font-display);font-size:1.8rem;font-weight:500;color:var(--color-copper);">0 ₺</span>
              </div>
            </FadeIn>

            <FadeIn class="col-span-12 md:col-span-7" delay={120}>
              <OrderForm lang={lang} />
            </FadeIn>

          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import { readCart, cartTotal, onCartChange } from '@/lib/cart';

  type Lang = 'tr' | 'en' | 'ar';

  function formatPrice(n: number, lang: Lang): string {
    const f = new Intl.NumberFormat(
      lang === 'tr' ? 'tr-TR' : lang === 'ar' ? 'ar' : 'en-US',
      { maximumFractionDigits: 0 }
    );
    return lang === 'ar' ? `${f.format(n)} ل.ت` : `${f.format(n)} ₺`;
  }

  const wire = () => {
    const html = document.documentElement;
    const lang = ((html.getAttribute('lang') ?? 'tr').split('-')[0] || 'tr') as Lang;
    const empty = document.querySelector<HTMLElement>('[data-summary-empty]');
    const linesEl = document.querySelector<HTMLElement>('[data-summary-lines]');
    const totalWrap = document.querySelector<HTMLElement>('[data-summary-total]');
    const totalVal = document.querySelector<HTMLElement>('[data-summary-total-value]');
    if (!empty || !linesEl || !totalWrap || !totalVal) return;

    const render = () => {
      const cart = readCart();
      if (cart.length === 0) {
        empty.hidden = false;
        linesEl.innerHTML = '';
        totalWrap.hidden = true;
        return;
      }
      empty.hidden = true;
      totalWrap.hidden = false;
      linesEl.innerHTML = '';
      for (const line of cart) {
        const li = document.createElement('li');
        li.className = 'py-3 flex items-baseline justify-between gap-3';

        const left = document.createElement('div');
        left.className = 'min-w-0';
        const name = document.createElement('div');
        name.className = 'text-[0.95rem] text-[var(--color-ink)] truncate';
        name.style.fontFamily = 'var(--font-display)';
        name.textContent = line.priceLabel ? `${line.qty}× ${line.name} (${line.priceLabel})` : `${line.qty}× ${line.name}`;
        const unit = document.createElement('div');
        unit.className = 'text-[0.78rem] text-[var(--color-ink)]/55 italic';
        unit.style.fontFamily = 'var(--font-display)';
        unit.textContent = formatPrice(line.price, lang);
        left.append(name, unit);

        const right = document.createElement('span');
        right.className = 'flex-shrink-0 italic';
        right.style.fontFamily = 'var(--font-display)';
        right.style.color = 'var(--color-copper)';
        right.textContent = formatPrice(line.qty * line.price, lang);

        li.append(left, right);
        linesEl.appendChild(li);
      }
      totalVal.textContent = formatPrice(cartTotal(), lang);
    };

    render();
    onCartChange(render);
  };

  document.addEventListener('astro:page-load', wire);
</script>
