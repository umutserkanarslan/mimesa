---
import { type Locale, getDict, localizedPath } from '@/lib/i18n';

interface Props {
  lang: Locale;
  eyebrow: string;
  title: string;
  titleEm: string;
  subtitle: string;
  backHref?: string;
  backLabel?: string;
}

const { lang, eyebrow, title, titleEm, subtitle, backHref, backLabel } = Astro.props;
const t = getDict(lang).nav;
const homeHref = localizedPath(lang, '/');
---

<section class="relative bg-[var(--color-champagne)] grain-bg overflow-hidden pt-36 pb-20 md:pt-44 md:pb-28">
  <!-- Decorative copper hairlines -->
  <div class="absolute top-[14%] start-6 md:start-12 w-px h-[24%] bg-[var(--color-copper)]/35"></div>
  <div class="absolute bottom-[18%] end-6 md:end-12 w-px h-[18%] bg-[var(--color-copper)]/35"></div>

  <!-- Oversized italic watermark -->
  <span
    aria-hidden="true"
    class="pointer-events-none absolute -top-12 end-0 md:-top-24 md:end-12 select-none opacity-[0.05]"
    style="font-family:var(--font-display);font-style:italic;font-size:clamp(16rem, 32vw, 32rem);line-height:0.8;color:var(--color-copper);"
  >M</span>

  <div class="container-luxe relative z-10">
    <!-- Breadcrumb / back -->
    <div class="flex items-center gap-3 text-[0.72rem] text-[var(--color-ink)]/60" style="letter-spacing:var(--tracking-wider-luxe);text-transform:uppercase;">
      <a href={homeHref} class="hover:text-[var(--color-copper)] transition-colors">Mi Mesa</a>
      <span class="block w-3 h-px bg-[var(--color-copper)]/40"></span>
      {backHref ? (
        <a href={backHref} class="hover:text-[var(--color-copper)] transition-colors">{backLabel}</a>
      ) : (
        <span>{t.menu}</span>
      )}
    </div>

    <div class="mt-12 md:mt-16 max-w-4xl">
      <span class="eyebrow">{eyebrow}</span>
      <h1
        class="mt-6"
        style="font-family:var(--font-display);font-size:clamp(2.6rem, 7.5vw, 6.5rem);line-height:0.98;letter-spacing:-0.01em;font-weight:400;color:var(--color-ink);"
      >
        <span class="block">{title}</span>
        <span class="block italic" style="color:var(--color-copper);">{titleEm}</span>
      </h1>

      <p class="mt-9 max-w-2xl text-[1rem] md:text-[1.08rem] leading-[1.85] text-[var(--color-ink)]/75">
        {subtitle}
      </p>
    </div>

    <span class="block hairline mt-14 md:mt-20 max-w-md"></span>
  </div>
</section>
