---
import { Image } from 'astro:assets';
import { type Locale, localizedPath } from '@/lib/i18n';
import { type MenuCategory, localized } from '@/lib/menu';

interface Props {
  lang: Locale;
  category: MenuCategory;
  index: number;
  total: number;
  itemCount: number;
  itemsLabel: string;
  enterLabel: string;
}

const { lang, category, index, total, itemCount, itemsLabel, enterLabel } = Astro.props;

const href = localizedPath(lang, `/menu/${category.slug}`);
const numeral = String(index).padStart(2, '0');
const totalStr = String(total).padStart(2, '0');
const name = localized(category.name, lang);
const tagline = localized(category.tagline, lang);
const description = localized(category.description, lang);
---

<a href={href} class="group relative block">
  <article class="relative bg-[var(--color-offwhite)] overflow-hidden">
    <!-- Image -->
    <div class="relative w-full overflow-hidden" style="aspect-ratio:4/5;">
      <Image
        src={category.cover}
        alt={name}
        width={1200}
        height={1500}
        loading="lazy"
        decoding="async"
        class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
      />
      <!-- Tonal overlay -->
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-black/45"></div>
      <!-- Copper hairline corner ornaments -->
      <div class="absolute top-4 start-4 w-6 h-6 border-t border-s border-[var(--color-copper)]/55"></div>
      <div class="absolute bottom-4 end-4 w-6 h-6 border-b border-e border-[var(--color-copper)]/55"></div>

      <!-- Numeral overlay -->
      <span
        class="absolute top-5 end-5 text-[var(--color-champagne)]/85 text-[0.72rem]"
        style="letter-spacing:var(--tracking-wider-luxe);font-family:var(--font-body);"
      >{numeral} <span class="text-[var(--color-champagne)]/45">/ {totalStr}</span></span>

      <!-- Bottom caption -->
      <div class="absolute inset-x-0 bottom-0 p-5 md:p-7">
        <span class="block text-[0.68rem] text-[var(--color-champagne)]/70 mb-2" style="letter-spacing:var(--tracking-wider-luxe);text-transform:uppercase;">
          {itemCount} {itemsLabel}
        </span>
        <h3
          class="text-[var(--color-champagne)]"
          style="font-family:var(--font-display);font-size:clamp(1.7rem,3vw,2.4rem);line-height:1.05;font-weight:400;"
        >
          <span class="block">{name}</span>
          <span class="block italic text-[var(--color-copper-soft)] text-[0.68em] mt-1">{tagline}</span>
        </h3>
      </div>
    </div>

    <!-- Description block beneath image -->
    <div class="p-6 md:p-8 relative">
      <p class="text-[0.92rem] md:text-[0.96rem] leading-[1.8] text-[var(--color-ink)]/75">
        {description}
      </p>
      <div class="mt-6 flex items-center gap-3 text-[0.72rem] text-[var(--color-copper)]" style="letter-spacing:var(--tracking-wider-luxe);text-transform:uppercase;">
        <span class="block w-8 h-px bg-[var(--color-copper)] transition-all duration-500 group-hover:w-16"></span>
        <span>{enterLabel}</span>
      </div>
    </div>
  </article>
</a>
