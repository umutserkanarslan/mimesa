---
import { type Locale, getDict } from '@/lib/i18n';
import FadeIn from './FadeIn.astro';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = getDict(lang).reservation;
const c = getDict(lang).contact;
---

<section id="reservation" class="relative bg-[var(--color-champagne-soft)] text-[var(--color-ink)] py-28 md:py-44 overflow-hidden grain-bg">
  <div class="container-luxe relative z-10">
    <div class="grid grid-cols-12 gap-x-6 gap-y-12">

      <div class="col-span-12 md:col-span-5 flex flex-col gap-7">
        <FadeIn class="flex items-center gap-4">
          <span class="hairline w-12"></span>
          <span class="eyebrow">{t.eyebrow}</span>
        </FadeIn>
        <FadeIn delay={120}>
          <h2 style="font-family:var(--font-display);font-size:clamp(2.2rem,5vw,4.2rem);line-height:1.05;font-weight:400;">
            <span class="block">{t.title}</span>
            <span class="block italic" style="color:var(--color-copper);">{t.titleEm}</span>
          </h2>
        </FadeIn>
        <FadeIn delay={240}>
          <p class="text-[1rem] leading-[1.8] text-[var(--color-ink)]/75 max-w-md">{t.body}</p>
        </FadeIn>
        <FadeIn delay={360} class="mt-4 flex flex-col gap-1.5">
          <span class="hairline w-10 mb-3"></span>
          <span class="text-[0.85rem] text-[var(--color-ink)]/80" style="font-family:var(--font-display);font-style:italic;">{c.address}</span>
          {c.addressLines.map((line) => (
            <span class="text-[0.92rem] text-[var(--color-ink)]/70">{line}</span>
          ))}
        </FadeIn>
      </div>

      <FadeIn class="col-span-12 md:col-start-7 md:col-span-6" delay={300}>
        <form
          name="reservation"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          action="?success=1"
          class="grid grid-cols-2 gap-x-6 gap-y-7"
        >
          <input type="hidden" name="form-name" value="reservation" />
          <p class="hidden" aria-hidden="true">
            <label>Don't fill: <input name="bot-field" /></label>
          </p>

          <label class="col-span-2 sm:col-span-1 flex flex-col gap-2">
            <span class="text-[0.72rem] uppercase text-[var(--color-ink)]/60" style="letter-spacing:var(--tracking-wider-luxe);">{t.form.name}</span>
            <input type="text" name="name" required class="form-line" autocomplete="name" />
          </label>

          <label class="col-span-2 sm:col-span-1 flex flex-col gap-2">
            <span class="text-[0.72rem] uppercase text-[var(--color-ink)]/60" style="letter-spacing:var(--tracking-wider-luxe);">{t.form.email}</span>
            <input type="email" name="email" required class="form-line" autocomplete="email" />
          </label>

          <label class="col-span-2 sm:col-span-1 flex flex-col gap-2">
            <span class="text-[0.72rem] uppercase text-[var(--color-ink)]/60" style="letter-spacing:var(--tracking-wider-luxe);">{t.form.phone}</span>
            <input type="tel" name="phone" class="form-line" autocomplete="tel" />
          </label>

          <label class="col-span-2 sm:col-span-1 flex flex-col gap-2">
            <span class="text-[0.72rem] uppercase text-[var(--color-ink)]/60" style="letter-spacing:var(--tracking-wider-luxe);">{t.form.guests}</span>
            <input type="number" name="guests" min="1" max="20" class="form-line" />
          </label>

          <label class="col-span-2 sm:col-span-1 flex flex-col gap-2">
            <span class="text-[0.72rem] uppercase text-[var(--color-ink)]/60" style="letter-spacing:var(--tracking-wider-luxe);">{t.form.date}</span>
            <input type="date" name="date" required class="form-line" />
          </label>

          <label class="col-span-2 sm:col-span-1 flex flex-col gap-2">
            <span class="text-[0.72rem] uppercase text-[var(--color-ink)]/60" style="letter-spacing:var(--tracking-wider-luxe);">{t.form.time}</span>
            <input type="time" name="time" required class="form-line" />
          </label>

          <label class="col-span-2 flex flex-col gap-2">
            <span class="text-[0.72rem] uppercase text-[var(--color-ink)]/60" style="letter-spacing:var(--tracking-wider-luxe);">{t.form.note}</span>
            <textarea name="note" rows="3" placeholder={t.form.notePlaceholder} class="form-line resize-none"></textarea>
          </label>

          <div class="col-span-2 mt-4">
            <button type="submit" class="btn-copper">{t.form.submit}</button>
          </div>
        </form>
      </FadeIn>
    </div>
  </div>
</section>

<style>
  .form-line {
    background: transparent;
    border: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 30%, transparent);
    padding: 0.65rem 0;
    font-family: var(--font-body);
    font-size: 0.98rem;
    color: var(--color-ink);
    transition: border-color .4s ease;
  }
  html[lang="ar"] .form-line { font-family: var(--font-arabic-body); }
  .form-line:focus {
    outline: none;
    border-bottom-color: var(--color-copper);
  }
  .form-line::placeholder { color: color-mix(in srgb, var(--color-ink) 35%, transparent); }
  textarea.form-line { line-height: 1.6; }
</style>
