---
import { Image } from 'astro:assets';
import { type Locale, getDict } from '@/lib/i18n';
import FadeIn from './FadeIn.astro';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = getDict(lang).heritage;

const images = [
  {
    src: 'https://images.unsplash.com/photo-1509440159596-0249088772ff?auto=format&fit=crop&w=1400&q=80',
    caption: t.captions.one,
    span: 'md:col-span-7 md:row-span-2 md:translate-y-0',
    h: 720,
  },
  {
    src: 'https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=1200&q=80',
    caption: t.captions.two,
    span: 'md:col-span-5 md:row-span-2 md:translate-y-12',
    h: 720,
  },
  {
    src: 'https://images.unsplash.com/photo-1511690656952-34342bb7c2f2?auto=format&fit=crop&w=1400&q=80',
    caption: t.captions.three,
    span: 'md:col-span-7 md:-translate-y-4',
    h: 480,
  },
  {
    src: 'https://images.unsplash.com/photo-1414235077428-338989a2e8c0?auto=format&fit=crop&w=1200&q=80',
    caption: t.captions.four,
    span: 'md:col-span-5 md:translate-y-8',
    h: 420,
  },
];
---

<section id="heritage" class="relative bg-[var(--color-charcoal)] text-[var(--color-champagne)] py-28 md:py-44 grain-bg overflow-hidden">
  <div class="container-luxe relative z-10">
    <FadeIn class="flex items-center gap-4">
      <span class="block w-12 h-px bg-[var(--color-copper)]/70"></span>
      <span class="eyebrow">{t.eyebrow}</span>
    </FadeIn>

    <div class="mt-12 md:mt-20 grid grid-cols-12 gap-x-6 gap-y-10 items-end">
      <FadeIn class="col-span-12 md:col-span-7" delay={120}>
        <h2 class="text-[var(--color-champagne)]" style="font-family:var(--font-display);font-size:clamp(2.4rem, 6vw, 5.4rem);line-height:1.02;letter-spacing:-0.01em;font-weight:400;">
          <span class="block">{t.title}</span>
          <span class="block italic" style="color:var(--color-copper-soft);">{t.titleEm}</span>
        </h2>
      </FadeIn>
      <FadeIn class="col-span-12 md:col-start-8 md:col-span-5" delay={300}>
        <p class="text-[1.02rem] md:text-[1.08rem] leading-[1.85] text-[var(--color-champagne)]/75">{t.body}</p>
      </FadeIn>
    </div>

    <div class="mt-20 md:mt-28 grid grid-cols-12 gap-6 md:gap-8">
      {images.map((img, i) => (
        <FadeIn class:list={['col-span-12', img.span, 'group']} delay={120 * (i + 1)}>
          <figure class="relative overflow-hidden">
            <div class="relative w-full" style={`aspect-ratio: ${i < 2 ? '4/5' : '4/3'};`}>
              <Image
                src={img.src}
                alt={img.caption}
                width={1600}
                height={img.h}
                loading="lazy"
                decoding="async"
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
              />
              <div class="absolute inset-0 ring-1 ring-[var(--color-copper)]/0 group-hover:ring-[var(--color-copper)]/40 transition-[box-shadow,ring-color] duration-700"></div>
            </div>
            <figcaption class="mt-3 flex items-center gap-3 text-[0.72rem] text-[var(--color-champagne)]/60" style="letter-spacing:var(--tracking-wide-luxe);text-transform:uppercase;">
              <span class="block w-5 h-px bg-[var(--color-copper)]/60"></span>
              {img.caption}
            </figcaption>
          </figure>
        </FadeIn>
      ))}
    </div>
  </div>
</section>
