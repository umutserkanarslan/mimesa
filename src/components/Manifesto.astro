---
import { type Locale, getDict } from '@/lib/i18n';
import FadeIn from './FadeIn.astro';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = getDict(lang).manifesto;
---

<section id="manifesto" class="relative bg-[var(--color-offwhite)] text-[var(--color-ink)] py-28 md:py-44 grain-bg overflow-hidden">
  <div class="container-luxe relative z-10">
    <FadeIn class="flex items-center gap-4">
      <span class="hairline w-12"></span>
      <span class="eyebrow">{t.eyebrow}</span>
    </FadeIn>

    <div class="mt-12 md:mt-20 grid grid-cols-12 gap-x-6 gap-y-12">
      <FadeIn class="col-span-12 md:col-span-7" delay={120}>
        <h2 style="font-family:var(--font-display);font-size:clamp(2.4rem, 6vw, 5.4rem);line-height:1.02;letter-spacing:-0.01em;font-weight:400;">
          <span class="block">{t.title}</span>
          <span class="block italic" style="color:var(--color-copper);">{t.titleEm}</span>
        </h2>
      </FadeIn>

      <div class="col-span-12 md:col-start-8 md:col-span-5 flex flex-col gap-7">
        <FadeIn delay={300}>
          <p class="text-[1.02rem] md:text-[1.08rem] leading-[1.85] text-[var(--color-ink)]/85">{t.body}</p>
        </FadeIn>
        <FadeIn delay={420}>
          <span class="hairline w-16"></span>
          <p class="mt-7 italic text-[1rem] md:text-[1.05rem] leading-[1.85] text-[var(--color-ink)]/75" style="font-family:var(--font-display);">{t.body2}</p>
        </FadeIn>
      </div>
    </div>
  </div>

  <!-- Decorative oversized initial -->
  <span
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-12 end-4 md:-bottom-24 md:end-12 select-none opacity-[0.06]"
    style="font-family:var(--font-display);font-style:italic;font-size:clamp(20rem, 40vw, 40rem);line-height:0.8;color:var(--color-copper);"
  >M</span>
</section>
