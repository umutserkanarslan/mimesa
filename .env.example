# Supabase — public client (read-only, exposed to browser)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase — server-only (NEVER commit, used by seed/migration scripts AND /api/order)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Telegram — server-only. Bot via @BotFather, chat ID via getUpdates.
# Empty values disable Telegram (order still saves to DB).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
